# Delta Exchange API Credentials (Leave blank for SHADOW simulation)
DELTA_API_KEY=
DELTA_API_SECRET=

# Gateway: Use Delta India (default) or Delta Global
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://india.delta.exchange/v2/stream

# Trading Settings
TRADING_MODE=SHADOW
STARTING_CAPITAL=60.0
TARGET_CAPITAL=5000.0

# Server
HOST=127.0.0.1
PORT=8000
